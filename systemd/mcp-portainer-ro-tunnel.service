[Unit]
Description=Portainer read-only MCP SSH tunnel to gateway host
Documentation=man:ssh(1)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new -L 127.0.0.1:18811:127.0.0.1:8811 <user>@<gateway-host>
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
